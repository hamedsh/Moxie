# Example environment configuration file
# Copy this to .env and update with your settings

# Environment
ENV=development
RELEASE=0.1.0

# API Configuration
API_V1_STR=/api/api_v1
PROJECT_NAME=statuscode_test_tool

# Sentry (optional - for error tracking)
# SENTRY_DSN=https://key@sentry.io/project-id

# Database Configuration
# For SQLite (default)
DB_TYPE=sqlite
DB_PATH=app.db

# For PostgreSQL (uncomment to use)
# DB_TYPE=postgresql
# DB_HOST=postgres
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=statuscode_tool
# DB_PORT=5432

# For MySQL (uncomment to use)
# DB_TYPE=mysql
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=password
# DB_DATABASE=statuscode_tool
# DB_PORT=3306

# Connection Pool Configuration
# Tune these based on your workload
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600
DB_POOL_PRE_PING=True
DB_ECHO=False

# Test Database Configuration
TEST_DB_TYPE=sqlite
TEST_DB_PATH=test_app.db
# TEST_DB_HOST=localhost
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=postgres
# TEST_DB_DATABASE=test_statuscode_tool
# TEST_DB_PORT=5432
